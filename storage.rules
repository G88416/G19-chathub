rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ========== HELPER FUNCTIONS ==========
    
    // Check if user is authenticated (required for all operations)
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user is part of a chat (chatId format: userId1_userId2)
    // Also allows self-chat where both IDs are the same (userId_userId)
    // Uses regex to ensure exact boundary matching
    function isParticipant(chatId) {
      return isSignedIn() && (
        chatId.matches('^' + request.auth.uid + '_[^_]+$') || 
        chatId.matches('^[^_]+_' + request.auth.uid + '$') ||
        chatId == request.auth.uid + '_' + request.auth.uid
      );
    }
    
    // Validate file size (prevents abuse and ensures storage limits)
    // maxSizeMB: maximum file size in megabytes
    function isValidFileSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }
    
    // Validate file types for general chat file uploads
    // Allowed: images, videos, audio, documents, text files
    // This prevents malicious file uploads while supporting common file types
    function isValidFileType() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/gif'
        || request.resource.contentType == 'image/webp'
        || request.resource.contentType == 'video/mp4'
        || request.resource.contentType == 'video/webm'
        || request.resource.contentType == 'video/ogg'
        || request.resource.contentType == 'audio/mpeg'
        || request.resource.contentType == 'audio/wav'
        || request.resource.contentType == 'audio/ogg'
        || request.resource.contentType == 'audio/webm'
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || request.resource.contentType == 'application/vnd.ms-powerpoint'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || request.resource.contentType == 'text/plain'
        || request.resource.contentType == 'text/csv';
    }
    
    // Validate voice message types (audio only)
    function isValidVoiceType() {
      return request.resource.contentType == 'audio/webm'
        || request.resource.contentType == 'audio/mpeg'
        || request.resource.contentType == 'audio/wav'
        || request.resource.contentType == 'audio/ogg';
    }
    
    // Validate image types (for profile and group photos)
    function isValidImageType() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/gif'
        || request.resource.contentType == 'image/webp';
    }
    
    // Check if user is a group admin by querying Firestore
    function isGroupAdmin(groupId) {
      return firestore.get(/databases/(default)/documents/groups/$(groupId)).data.admins.hasAny([request.auth.uid]);
    }
    
    // ========== PROFILE PHOTOS ==========
    // Storage path: /profiles/{userId}/{fileName}
    // Used for user profile pictures in authentication and settings
    
    match /profiles/{userId}/{fileName} {
      // READ: Anyone authenticated can read profile photos
      // This allows:
      // - Displaying profile pictures in chat list
      // - Showing avatars in message threads
      // - Viewing user profiles before starting chats
      allow read: if isSignedIn();
      
      // CREATE/UPDATE: Users can only upload their own profile photo
      // Requirements:
      // - User must be authenticated
      // - userId in path must match authenticated user
      // - File size must be under 5MB (prevents storage abuse)
      // - File must be an image type (jpeg, png, gif, webp)
      // This enables profile photo upload in signup and settings
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isValidFileSize(5)
        && isValidImageType();
      
      // DELETE: Users can delete their own profile photo
      // Allows removing profile picture in settings
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    // ========== GROUP PHOTOS ==========
    // Storage path: /groups/{groupId}/{fileName}
    // Used for group chat pictures and avatars
    
    match /groups/{groupId}/{fileName} {
      // READ: Anyone authenticated can read group photos
      // This allows:
      // - Displaying group pictures in chat list
      // - Showing group avatars in group info
      // - Viewing group images before joining
      allow read: if isSignedIn();
      
      // CREATE/UPDATE: Only group admins can upload/update group photos
      // Requirements:
      // - User must be a group admin (verified via Firestore query)
      // - File size must be under 5MB
      // - File must be an image type
      // This ensures only admins can manage group appearance
      allow create, update: if isSignedIn()
        && isGroupAdmin(groupId)
        && isValidFileSize(5)
        && isValidImageType();
      
      // DELETE: Only group admins can delete group photos
      allow delete: if isSignedIn() && isGroupAdmin(groupId);
    }
    
    // ========== CHAT FILES ==========
    // Storage path: /files/{chatId}/{fileName}
    // Used for images, videos, documents shared in chats
    
    match /files/{chatId}/{fileName} {
      // READ: Only chat participants can read files
      // This ensures:
      // - File privacy between chat participants
      // - Unauthorized users cannot access shared files
      // - Self-chat file access for personal file storage
      allow read: if isParticipant(chatId);
      
      // CREATE: Only chat participants can upload files
      // Requirements:
      // - User must be a participant in the chat
      // - File size must be under 10MB (reasonable limit for chat files)
      // - File must be a valid type (images, videos, documents, etc.)
      // This enables file sharing in chat conversations
      // Supports: Images, videos, audio, PDFs, Office docs, text files
      allow create: if isParticipant(chatId)
        && isValidFileSize(10)
        && isValidFileType();
      
      // UPDATE/DELETE: Not allowed to preserve file history integrity
      // Once uploaded, files cannot be modified or removed
      // This ensures shared files remain accessible in chat history
    }
    
    // ========== VOICE MESSAGES ==========
    // Storage path: /voice/{chatId}/{fileName}
    // Used for audio recordings sent in chats
    
    match /voice/{chatId}/{fileName} {
      // READ: Only chat participants can read voice messages
      // Ensures voice message privacy between participants
      allow read: if isParticipant(chatId);
      
      // CREATE: Only chat participants can upload voice messages
      // Requirements:
      // - User must be a participant in the chat
      // - File size must be under 5MB (typical for voice recordings)
      // - File must be an audio type (webm, mp3, wav, ogg)
      // This enables voice message recording and sending
      allow create: if isParticipant(chatId)
        && isValidFileSize(5)
        && isValidVoiceType();
      
      // UPDATE/DELETE: Not allowed to preserve voice message history
      // Voice messages are immutable once sent
    }
  }
}
