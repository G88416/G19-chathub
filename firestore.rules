rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner of a document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is part of a chat (chatId format: userId1_userId2)
    function isParticipant(chatId) {
      return isSignedIn() && (
        chatId.matches('^' + request.auth.uid + '_.+$') || 
        chatId.matches('^.+_' + request.auth.uid + '$')
      );
    }
    
    // Users collection - stores user profiles
    match /users/{userId} {
      // Anyone can read user profiles (needed to search for users to chat with)
      allow read: if isSignedIn();
      
      // Only the user can create their own profile
      allow create: if isOwner(userId);
      
      // Only the user can update their own profile
      allow update: if isOwner(userId);
    }
    
    // Chats collection - stores all chat data
    match /chats/{chatId} {
      // Only participants can read chat metadata
      allow read: if isParticipant(chatId);
      
      // Participants can create chat (implicitly created when adding messages)
      allow create: if isParticipant(chatId);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read all messages in their chats
        allow read: if isParticipant(chatId);
        
        // Participants can send messages (create)
        // Must include senderId that matches authenticated user
        allow create: if isParticipant(chatId) 
          && request.resource.data.senderId == request.auth.uid;
      }
      
      // Typing status subcollection
      match /status/typing {
        // Participants can read typing status
        allow read: if isParticipant(chatId);
        
        // Participants can update their own typing status
        allow write: if isParticipant(chatId) 
          && request.resource.data.userId == request.auth.uid;
      }
      
      // Video call signaling - offer document
      match /call/offer {
        // Participants can read and write call offers
        allow read, write: if isParticipant(chatId);
      }
      
      // Video call signaling - answer document
      match /call/answer {
        // Participants can read and write call answers
        allow read, write: if isParticipant(chatId);
      }
      
      // Video call ICE candidates - caller
      match /call/candidates/caller/{candidateId} {
        // Participants can read and create ICE candidates
        allow read, create: if isParticipant(chatId);
      }
      
      // Video call ICE candidates - callee
      match /call/candidates/callee/{candidateId} {
        // Participants can read and create ICE candidates
        allow read, create: if isParticipant(chatId);
      }
    }
  }
}
