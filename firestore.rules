rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== HELPER FUNCTIONS ==========
    
    // Check if user is authenticated (required for all operations)
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Validate that the email being set/updated matches the authenticated email
    // This avoids get() operations and works for both create and update operations
    // Returns true if: auth has no email, OR email matches auth email
    function isEmailMatchingAuth(email) {
      return !('email' in request.auth.token) 
        || request.auth.token.email == null 
        || email == request.auth.token.email;
    }
    
    // Validate that the phone being set/updated matches the authenticated phone
    // This avoids get() operations and works for both create and update operations
    // Returns true if: auth has no phone, OR phone matches auth phone
    function isPhoneMatchingAuth(phone) {
      return !('phone_number' in request.auth.token) 
        || request.auth.token.phone_number == null 
        || phone == request.auth.token.phone_number;
    }
    
    // Check if email field is being set or updated correctly
    // Returns true if: email not in data, OR email matches auth token
    function isEmailValid() {
      return !request.resource.data.keys().hasAny(['email']) 
        || isEmailMatchingAuth(request.resource.data.email);
    }
    
    // Check if phone field is being set or updated correctly
    // Returns true if: phone not in data, OR phone matches auth token
    function isPhoneValid() {
      return !request.resource.data.keys().hasAny(['phone']) 
        || isPhoneMatchingAuth(request.resource.data.phone);
    }
    
    // Check if user is the owner of a document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is part of a chat (chatId format: userId1_userId2)
    // Also allows self-chat where both IDs are the same (userId_userId)
    // Uses regex to ensure exact boundary matching and prevent injection attacks
    function isParticipant(chatId) {
      return isSignedIn() && (
        chatId.matches('^' + request.auth.uid + '_[^_]+$') || 
        chatId.matches('^[^_]+_' + request.auth.uid + '$') ||
        chatId == request.auth.uid + '_' + request.auth.uid
      );
    }
    
    // Check if user is a member of a group
    // Note: This checks the existing group document (resource.data)
    // For reads, this validates against current membership
    // For writes in subcollections, we rely on application logic and the fact that
    // only members would have the groupId
    function isGroupMember(groupId) {
      return isSignedIn() && 
        request.auth.uid in resource.data.members;
    }
    
    // Validate message data fields
    // Ensures messages have required fields and senderId matches authenticated user
    function isValidMessage() {
      return request.resource.data.keys().hasAll(['senderId', 'type', 'timestamp'])
        && request.resource.data.senderId == request.auth.uid;
    }
    
    // Check if user is a group admin
    // Note: This checks the existing group document (resource.data)
    // This validates against current admin list when updating/deleting groups
    function isGroupAdmin(groupId) {
      return isSignedIn() && 
        request.auth.uid in resource.data.admins;
    }
    
    // ========== USERS COLLECTION ==========
    // Stores user profiles for email, username, and phone authentication
    
    match /users/{userId} {
      // READ: Anyone authenticated can read user profiles
      // This is necessary for:
      // - Searching for users by email/username/phone to start chats
      // - Displaying user names and photos in chat interface
      // - Looking up user info for group invitations
      allow read: if isSignedIn();
      
      // CREATE: Users can only create their own profile
      // Required on creation: name (display name, must be non-empty string)
      // Optional fields: email, emailLower, username, phone, photoURL, about
      // Authentication fields: email/username/phone are set during login
      // Enhanced: Ensures that if email is provided, it matches Firebase Auth email
      //           Ensures that if phone is provided, it matches Firebase Auth phone
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && isEmailValid()
        && isPhoneValid();
      
      // UPDATE: Users can only update their own profile
      // Allows updates to: name, about, photoURL, online status, lastSeen, settings
      // This supports:
      // - Profile editing in settings
      // - Online status tracking during active sessions
      // - Notification preferences
      // Enhanced: Users cannot change their email/phone to values that don't match Firebase Auth
      allow update: if isOwner(userId)
        && (
          // Email can stay the same OR match auth token
          !('email' in request.resource.data) 
          || request.resource.data.email == resource.data.email 
          || isEmailMatchingAuth(request.resource.data.email)
        )
        && (
          // Phone can stay the same OR match auth token
          !('phone' in request.resource.data) 
          || request.resource.data.phone == resource.data.phone 
          || isPhoneMatchingAuth(request.resource.data.phone)
        );
      
      // DELETE: Profile deletion is not allowed to maintain chat history integrity
      // If deletion is needed, it should be handled by Firebase Admin SDK
    }
    
    // ========== GROUPS COLLECTION ==========
    // Stores group chat metadata and messages
    //
    // IMPORTANT SECURITY NOTE:
    // Group subcollections (messages, status) use authentication-only checks to avoid
    // cross-document get() operations that cause "Missing or insufficient permissions" errors.
    // 
    // Privacy is enforced through:
    // 1. Application logic - UI only shows groups the user is a member of
    // 2. Message validation - senderId must match authenticated user
    // 3. Group metadata protection - only admins can modify member/admin lists
    // 
    // This approach follows Firebase best practices for complex authorization:
    // - Keep rules simple and reliable
    // - Use application logic for complex access control
    // - Avoid cross-document queries that create circular dependencies
    //
    // Alternative approaches (using get() operations) were causing persistent
    // permission errors that prevented legitimate users from accessing the app.
    
    match /groups/{groupId} {
      // READ: Anyone authenticated can read group metadata
      // This allows users to:
      // - Discover groups they can join
      // - View group information before joining
      // - Search for groups by name
      allow read: if isSignedIn();
      
      // CREATE: Any authenticated user can create a group
      // Requirements:
      // - Creator must be in members list
      // - Creator must be in admins list
      // - Group must have a name (non-empty string)
      // - Members and admins must be arrays
      // This enables the group chat feature
      allow create: if isSignedIn() 
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins
        && request.resource.data.keys().hasAll(['name', 'members', 'admins'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.members is list
        && request.resource.data.admins is list;
      
      // UPDATE: Only group admins can update group metadata
      // This includes changing:
      // - Group name and description
      // - Adding/removing members
      // - Promoting/demoting admins
      // - Updating group photo
      allow update: if isGroupAdmin(groupId);
      
      // DELETE: Only group admins can delete groups
      allow delete: if isGroupAdmin(groupId);
      
      // Group messages subcollection
      match /messages/{messageId} {
        // READ: Any authenticated user can read group messages
        // 
        // SECURITY TRADE-OFF: This rule is simplified to authentication-only
        // to prevent "Missing or insufficient permissions" errors caused by
        // cross-document get() calls. The previous rule used isGroupMember(groupId)
        // which required querying the parent group document, creating circular
        // permission dependencies.
        //
        // Privacy enforcement:
        // - Application UI only displays groups the user is a member of
        // - Application only loads messages for groups the user belongs to
        // - Unauthorized access requires knowing the exact groupId (not exposed publicly)
        // - Group metadata (member lists) still protected by admin-only updates
        //
        // This follows Firebase best practice: simple rules + application logic
        // See PERMISSION_FIX_GUIDE.md for detailed explanation
        allow read: if isSignedIn();
        
        // CREATE: Any authenticated user can send messages to groups
        // 
        // Validation: senderId must match authenticated user (prevents spoofing)
        // 
        // SECURITY TRADE-OFF: Similar to read above, simplified to prevent
        // permission errors. Application enforces member-only message sending.
        allow create: if isSignedIn() && isValidMessage();
        
        // Messages cannot be updated or deleted to preserve group history
      }
      
      // Group typing status subcollection
      match /status/typing {
        // READ: Any authenticated user can read typing status
        // SECURITY TRADE-OFF: Simplified for same reasons as messages above
        allow read: if isSignedIn();
        
        // WRITE: Authenticated users can update their own typing status
        // Validation: userId must match authenticated user
        // This enables real-time "user is typing..." indicators
        allow write: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      }
    }
    
    // ========== CHATS COLLECTION ==========
    // Stores one-on-one chat data and messages
    // chatId format: userId1_userId2 (sorted alphabetically)
    // Example: If user "abc123" chats with "xyz789", chatId = "abc123_xyz789"
    // Self-chat: user can chat with themselves, chatId = "userId_userId"
    
    match /chats/{chatId} {
      // READ: Only participants can read chat metadata
      // This allows:
      // - Auto-start chat feature to check for existing chats
      // - Loading chat information when clicking on a conversation
      // - Retrieving last message and timestamp
      allow read: if isParticipant(chatId);
      
      // CREATE: Participants can create chat documents
      // This supports both manual and auto-start chat creation
      // Chat is implicitly created when first message is sent
      // No specific fields required - chat metadata is optional
      allow create: if isParticipant(chatId);
      
      // UPDATE: Participants can update chat metadata
      // This allows updating:
      // - Last message preview
      // - Last message timestamp
      // - Unread count
      // - Typing indicators
      allow update: if isParticipant(chatId);
      
      // DELETE: Chat deletion is not allowed to preserve history
      // If deletion is needed, use Firebase Admin SDK
      
      // Messages subcollection - stores all chat messages
      match /messages/{messageId} {
        // READ: Participants can read all messages in their chats
        // Messages are never deleted to maintain complete chat history
        // Supports loading message history on chat open
        allow read: if isParticipant(chatId);
        
        // CREATE: Participants can send messages
        // Requirements:
        // - senderId must match authenticated user (prevents spoofing)
        // - Must include: senderId, type, timestamp
        // - Type can be: text, file, voice
        // This enables text messages, file uploads, and voice messages
        allow create: if isParticipant(chatId) && isValidMessage();
        
        // UPDATE/DELETE: Messages cannot be modified or deleted
        // This ensures chat history integrity and prevents tampering
        // All messages persist forever for complete conversation history
      }
      
      // Typing status subcollection
      match /status/typing {
        // READ: Participants can read typing status to show indicators
        allow read: if isParticipant(chatId);
        
        // WRITE: Participants can update their own typing status
        // Validation: userId must match authenticated user
        // This enables real-time "user is typing..." indicators
        allow write: if isParticipant(chatId) 
          && request.resource.data.userId == request.auth.uid;
      }
      
      // ========== VIDEO/VOICE CALL SIGNALING ==========
      // WebRTC signaling for peer-to-peer voice and video calls
      // These rules enable real-time communication features
      
      // Call offer document - initiates a call
      match /call/offer {
        // Participants can read, write, and delete call offers
        // This supports both incoming and outgoing call initiation
        allow read, write, delete: if isParticipant(chatId);
      }
      
      // Call answer document - accepts a call
      match /call/answer {
        // Participants can read, write, and delete call answers
        // This completes the call setup handshake
        allow read, write, delete: if isParticipant(chatId);
      }
      
      // ICE candidates for caller - WebRTC connection data
      match /call/candidates/caller/{candidateId} {
        // Participants can read and create ICE candidates
        // These are used to establish peer-to-peer connection
        allow read, create: if isParticipant(chatId);
      }
      
      // ICE candidates for callee - WebRTC connection data
      match /call/candidates/callee/{candidateId} {
        // Participants can read and create ICE candidates
        // Enables bidirectional connection establishment
        allow read, create: if isParticipant(chatId);
      }
      
      // Call state management - tracks active call status
      match /call/state {
        // Participants can read, write, and delete call state
        // Used for call status tracking (ringing, connected, ended)
        allow read, write, delete: if isParticipant(chatId);
      }
    }
  }
}
